{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arc-business-operating-account",
  "account_id": "1e0170aaabc90ecf5f466128d1f0466a",
  "main": "src/index.ts",
  // Latest date supported by the pinned workerd release used for verification.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "../dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "LEDGERS", "class_name": "LedgerObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LedgerObject"] }],
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
